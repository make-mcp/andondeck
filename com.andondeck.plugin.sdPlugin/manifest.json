{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"Name": "Andon Deck for Claude Code",
	"Version": "1.0.0.0",
	"Author": "claude-deck contributors",
	"Description": "Control Claude Code from your Stream Deck. Every key's border shows Claude's state the way a factory andon light does: working, waiting for you, or stopped. Live status, prompt queueing, permission approvals, plan limits and usage history, and a full-deck alert when Claude needs you — free and open source.",
	"Category": "Andon Deck for Claude Code",
	"CategoryIcon": "imgs/plugin/category-icon",
	"Icon": "imgs/plugin/marketplace",
	"URL": "https://github.com/make-mcp/andondeck",
	"SupportURL": "https://github.com/make-mcp/andondeck/issues",
	"CodePath": "bin/plugin.js",
	"PropertyInspectorPath": "ui/shared.html",
	"UUID": "com.andondeck.plugin",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		},
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		}
	],
	"Nodejs": {
		"Version": "20"
	},
	"Actions": [
		{
			"UUID": "com.andondeck.plugin.status",
			"Name": "Claude Status",
			"Tooltip": "Shows what Claude Code is doing right now: idle, working, waiting for you, or failed.",
			"Icon": "imgs/actions/status/icon",
			"Controllers": [
				"Keypad"
			],
			"PropertyInspectorPath": "ui/status.html",
			"SupportedInMultiActions": false,
			"UserTitleEnabled": false,
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/status/idle",
					"TitleAlignment": "bottom",
					"FontSize": 10
				}
			]
		},
		{
			"UUID": "com.andondeck.plugin.queue",
			"Name": "Queue Prompt",
			"Tooltip": "Queue a prompt while Claude is working. It is sent automatically when the current turn ends.",
			"Icon": "imgs/actions/queue/icon",
			"Controllers": [
				"Keypad"
			],
			"PropertyInspectorPath": "ui/queue.html",
			"UserTitleEnabled": false,
			"States": [
				{
					"Image": "imgs/actions/queue/key",
					"TitleAlignment": "bottom",
					"FontSize": 10
				}
			]
		},
		{
			"UUID": "com.andondeck.plugin.queue-control",
			"Name": "Queue Control",
			"Tooltip": "Browse, reorder, drop or clear queued prompts. Rotate the dial to scroll through the queue.",
			"Icon": "imgs/actions/queue-control/icon",
			"Controllers": [
				"Keypad",
				"Encoder"
			],
			"PropertyInspectorPath": "ui/queue-control.html",
			"UserTitleEnabled": false,
			"Encoder": {
				"layout": "$A1",
				"TriggerDescription": {
					"Push": "Apply action",
					"Rotate": "Scroll queue",
					"Touch": "Apply action",
					"LongTouch": "Clear queue"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/queue-control/key",
					"TitleAlignment": "bottom",
					"FontSize": 10
				}
			]
		},
		{
			"UUID": "com.andondeck.plugin.approve",
			"Name": "Approve / Deny",
			"Tooltip": "Answer Claude Code permission requests from your deck instead of the terminal.",
			"Icon": "imgs/actions/approve/icon",
			"Controllers": [
				"Keypad"
			],
			"PropertyInspectorPath": "ui/approve.html",
			"UserTitleEnabled": false,
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/approve/allow",
					"TitleAlignment": "bottom",
					"FontSize": 10
				},
				{
					"Image": "imgs/actions/approve/deny",
					"TitleAlignment": "bottom",
					"FontSize": 10
				}
			]
		},
		{
			"UUID": "com.andondeck.plugin.prompt",
			"Name": "Prompt / Slash Command",
			"Tooltip": "Replaced by Queue Prompt, which does the same and more. Kept so existing keys keep working.",
			"Icon": "imgs/actions/prompt/icon",
			"Controllers": [
				"Keypad"
			],
			"PropertyInspectorPath": "ui/prompt.html",
			"States": [
				{
					"Image": "imgs/actions/prompt/key",
					"TitleAlignment": "bottom",
					"FontSize": 10
				}
			],
			"VisibleInActionsList": false
		},
		{
			"UUID": "com.andondeck.plugin.session",
			"Name": "Session Switcher",
			"Tooltip": "Pick which Claude Code session the deck controls. Rotate to cycle through running sessions.",
			"Icon": "imgs/actions/session/icon",
			"Controllers": [
				"Keypad",
				"Encoder"
			],
			"PropertyInspectorPath": "ui/session.html",
			"UserTitleEnabled": false,
			"SupportedInMultiActions": false,
			"Encoder": {
				"layout": "$A1",
				"TriggerDescription": {
					"Push": "Pin / unpin session",
					"Rotate": "Cycle sessions",
					"Touch": "Pin / unpin session",
					"LongTouch": "Follow most recent"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/session/key",
					"TitleAlignment": "bottom",
					"FontSize": 10
				}
			]
		},
		{
			"UUID": "com.andondeck.plugin.headless",
			"Name": "Run Task",
			"Tooltip": "Run a one-shot Claude task in the background with `claude -p`, without touching your open session.",
			"Icon": "imgs/actions/headless/icon",
			"Controllers": [
				"Keypad"
			],
			"PropertyInspectorPath": "ui/headless.html",
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/headless/key",
					"TitleAlignment": "bottom",
					"FontSize": 10
				},
				{
					"Image": "imgs/actions/headless/running",
					"TitleAlignment": "bottom",
					"FontSize": 10
				}
			]
		},
		{
			"UUID": "com.andondeck.plugin.usage",
			"Name": "Usage & Timer",
			"Tooltip": "Turn timer, tool calls, token usage and context pressure for the session you are watching.",
			"Icon": "imgs/actions/usage/icon",
			"Controllers": [
				"Keypad",
				"Encoder"
			],
			"PropertyInspectorPath": "ui/usage.html",
			"UserTitleEnabled": false,
			"SupportedInMultiActions": false,
			"Encoder": {
				"layout": "$B1",
				"TriggerDescription": {
					"Push": "Switch metric",
					"Rotate": "Switch metric",
					"Touch": "Switch metric",
					"LongTouch": "Reset counters"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/usage/key",
					"TitleAlignment": "bottom",
					"FontSize": 10
				}
			]
		},
		{
			"UUID": "com.andondeck.plugin.autopilot",
			"Name": "Autopilot",
			"Tooltip": "Approve tool calls for a set stretch of time, then switch itself back off.",
			"Icon": "imgs/actions/autopilot/icon",
			"Controllers": [
				"Keypad"
			],
			"PropertyInspectorPath": "ui/autopilot.html",
			"SupportedInMultiActions": false,
			"UserTitleEnabled": false,
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/autopilot/off",
					"TitleAlignment": "bottom",
					"FontSize": 10
				},
				{
					"Image": "imgs/actions/autopilot/on",
					"TitleAlignment": "bottom",
					"FontSize": 10
				}
			]
		},
		{
			"UUID": "com.andondeck.plugin.halt",
			"Name": "Stop Claude",
			"Tooltip": "Emergency brake: blocks every further tool call so Claude winds down and reports back.",
			"Icon": "imgs/actions/halt/icon",
			"Controllers": [
				"Keypad"
			],
			"PropertyInspectorPath": "ui/halt.html",
			"UserTitleEnabled": false,
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/halt/key",
					"TitleAlignment": "bottom",
					"FontSize": 10
				},
				{
					"Image": "imgs/actions/halt/stopped",
					"TitleAlignment": "bottom",
					"FontSize": 10
				}
			]
		},
		{
			"UUID": "com.andondeck.plugin.model",
			"Name": "Model",
			"Tooltip": "Shows the session's model. A press copies /model with the next one, ready to paste; Claude Code only switches models from its own prompt.",
			"Icon": "imgs/actions/model/icon",
			"Controllers": [
				"Keypad"
			],
			"PropertyInspectorPath": "ui/model.html",
			"UserTitleEnabled": false,
			"States": [
				{
					"Image": "imgs/actions/model/key",
					"TitleAlignment": "bottom",
					"FontSize": 10
				}
			]
		},
		{
			"UUID": "com.andondeck.plugin.slot",
			"Name": "Session Slot",
			"Tooltip": "Gives one Claude Code session a key of its own, held for the session's whole life.",
			"Icon": "imgs/actions/slot/icon",
			"Controllers": [
				"Keypad"
			],
			"PropertyInspectorPath": "ui/slot.html",
			"UserTitleEnabled": false,
			"States": [
				{
					"Image": "imgs/actions/slot/key",
					"TitleAlignment": "bottom",
					"FontSize": 10
				}
			]
		},
		{
			"UUID": "com.andondeck.plugin.launch",
			"Name": "Launch Claude",
			"Tooltip": "Opens a terminal with an interactive Claude Code session in a folder you choose.",
			"Icon": "imgs/actions/launch/icon",
			"Controllers": [
				"Keypad"
			],
			"PropertyInspectorPath": "ui/launch.html",
			"States": [
				{
					"Image": "imgs/actions/launch/key",
					"TitleAlignment": "bottom",
					"FontSize": 10
				}
			]
		},
		{
			"UUID": "com.andondeck.plugin.setup",
			"Name": "Connect Claude Code",
			"Tooltip": "One-time setup: installs the Andon Deck hooks into your Claude Code settings and shows bridge health.",
			"Icon": "imgs/actions/setup/icon",
			"Controllers": [
				"Keypad"
			],
			"PropertyInspectorPath": "ui/setup.html",
			"SupportedInMultiActions": false,
			"UserTitleEnabled": false,
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/setup/disconnected",
					"TitleAlignment": "bottom",
					"FontSize": 10
				},
				{
					"Image": "imgs/actions/setup/connected",
					"TitleAlignment": "bottom",
					"FontSize": 10
				}
			]
		},
		{
			"UUID": "com.andondeck.plugin.alert",
			"Name": "Alert",
			"Tooltip": "One key of the full-deck alert that shows when Claude needs you. Placed by the bundled Alert profiles; any press goes back.",
			"Icon": "imgs/actions/status/icon",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": false,
			"UserTitleEnabled": false,
			"DisableAutomaticStates": true,
			"VisibleInActionsList": false,
			"States": [
				{
					"Image": "imgs/actions/status/idle",
					"TitleAlignment": "bottom",
					"FontSize": 10
				}
			]
		}
	],
	"Profiles": [
		{
			"Name": "Andon Deck",
			"DeviceType": 0,
			"Readonly": false,
			"DontAutoSwitchWhenInstalled": true,
			"AutoInstall": true
		},
		{
			"Name": "Andon Deck Mini",
			"DeviceType": 1,
			"Readonly": false,
			"DontAutoSwitchWhenInstalled": true,
			"AutoInstall": true
		},
		{
			"Name": "Andon Deck XL",
