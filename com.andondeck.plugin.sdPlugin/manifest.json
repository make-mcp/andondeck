			"AutoInstall": true
		},
		{
			"Name": "Andon Deck Virtual",
			"DeviceType": 11,
			"Readonly": false,
			"DontAutoSwitchWhenInstalled": true,
			"AutoInstall": true
		},
		{
			"Name": "Andon Deck Alert",
			"DeviceType": 0,
